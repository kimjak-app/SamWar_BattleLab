	"mil_u": {"id": "mil_u", "hero_id": "mil_u", "display_name": "밀우", "name": "밀우", "role": "돌격", "faction_id": "", "force_id": "", "side": "", "nation": "", "assigned_city_id": "", "city_id": "", "location_city_id": "", "unique_skill_id": "mil_u_unique", "skill_id": "mil_u_unique", "skill_name": "구원 결사", "skill_desc": "단일 고위력 피해", "skill_effect_type": "single_burst", "skill_power": 86, "skill_value": 86, "portrait_path": "res://assets/heroes/portraits/korea/korea_mil_u.png", "portrait_image": "", "battlefield_portrait_image": "", "hanja": "密友", "roster_faction": "고구려", "description": "밀우(密友)는 『삼국사기』 고구려본기에 보이는 장수다. 백제 근초고왕의 공격으로 고국원왕이 위기에 처하자 유유와 함께 왕을 구하고 적진을 흔들었다. 충성과 돌격이 겹친 인물이다. 고국원왕이 백제 근초고왕의 공격으로 위기에 처하자 유유와 함께 왕을 구하고 적진을 흔들었다고 『삼국사기』는 전한다. 개별 성격은 짧게만 남아 있다. 위기에서 주군을 지키는 호위·구원형 장수로 읽힌다. 왕을 구하는 자리에서 몸을 던진 고구려의 호위 장수다. 고국원왕 구원의 한 축을 맡은 장수로 남았다.", "review_status": "로컬 검토 제안(사료·구현·김작 승인 필요)", "stats_approved": true},
